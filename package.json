{
  "name": "n8n-nodes-apivault-job-leads",
  "version": "0.1.0",
  "description": "n8n community node for Job Posting Lead Finder — find companies hiring now across Indeed + LinkedIn, enriched into B2B sales leads: leadScore, USD salary parser, tech-skills extraction, cross-source dedup, 3-variant outreach pitches, CRM-ready export. No login. Pay-as-you-go, no monthly fee.",
  "license": "MIT",
  "homepage": "https://apify.com/apivault_labs/apify-actor-job-leads",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "job-scraper",
    "indeed-scraper",
    "linkedin-jobs",
    "lead-generation",
    "b2b-prospecting",
    "hiring-signals",
    "sales-prospecting",
    "outreach-automation",
    "apollo-alternative",
    "apify"
  ],
  "author": {
    "name": "apivault_labs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/apivault-labs/n8n-nodes-apivault-job-leads.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && copyfiles \"nodes/**/*.svg\" dist",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ApifyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/JobLeads/JobLeads.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "copyfiles": "^2.4.1",
    "n8n-workflow": "*",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
